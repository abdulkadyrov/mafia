VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Локальный режим без SMS. Никогда не включайте его в production-сборке.
VITE_MAFIA_DEV_AUTH=false
VITE_MAFIA_DEV_OTP=000000
# Секрет/переменная Edge Function, задаётся через `supabase secrets set`.
ALLOWED_ORIGINS=http://localhost:5173

# Необязательно: временные TURN-учётные данные для сетей, где STUN недостаточно.
VITE_MAFIA_TURN_URL=
VITE_MAFIA_TURN_USERNAME=
VITE_MAFIA_TURN_CREDENTIAL=
